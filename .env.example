# 后端与数据库
DB_URL=jdbc:mysql://127.0.0.1:3306/party_build?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=party
DB_PASSWORD=party_dev_2026

# JWT 与字段加密（生产必须替换为 32 字节以上随机值）
JWT_SECRET=dev-only-secret-change-me-please-32bytes-minimum
CRYPTO_KEY=dev-only-crypto-key-32-bytes-min

# 大模型（OpenAI 兼容接口）
# POC 当前使用 tokenrhythm / deepseek-v4.1-flash-1017；也可切换豆包等兼容服务
LLM_PROVIDER=tokenrhythm
LLM_BASE_URL=https://tokenrhythm.studio/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_API_KEY=请填写
LLM_MOCK=false
LLM_TIMEOUT_SECONDS=30

# 文件与 OCR
FILE_ROOT=./data/files
TESSERACT_CMD=tesseract
TESSERACT_LANG=chi_sim+eng

# 前端跨域
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dangjian.morose.top,http://dangjian.morose.top,http://64.83.11.147